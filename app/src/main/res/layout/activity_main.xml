<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/purple_dark"
    tools:context=".MainActivity">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.aiface.detector.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Scanline effect overlay -->
    <View
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:background="#66E0AAFF"
        android:alpha="0.6"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top info bar - PURPLE PIXEL STYLE -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/text_bg"
        android:orientation="horizontal"
        android:padding="12dp"
        android:elevation="8dp"
        android:backgroundTint="@color/purple_dark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/fpsText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="FPS: 0"
            android:textColor="@color/purple_glow"
            android:textSize="9sp"
            android:fontFamily="@font/press_start_2p"
            android:shadowColor="@color/purple_mid"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4" />

        <TextView
            android:id="@+id/facesText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FACES: 0"
            android:textColor="@color/pink_neon"
            android:textSize="9sp"
            android:fontFamily="@font/press_start_2p"
            android:layout_marginEnd="12dp"
            android:shadowColor="@color/pink_neon"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="8" />

        <TextView
            android:id="@+id/modeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● LIVE"
            android:textColor="@color/white"
            android:textSize="8sp"
            android:fontFamily="@font/press_start_2p"
            android:background="@color/purple_light"
            android:padding="6dp"
            android:elevation="4dp" />

    </LinearLayout>

    <!-- Bottom controls - PURPLE PIXEL -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/text_bg"
        android:padding="12dp"
        android:gravity="center"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSwitchCamera"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CAM"
            android:textSize="8sp"
            android:fontFamily="@font/press_start_2p"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/purple_mid"
            android:textColor="@color/purple_glow"
            app:strokeColor="@color/purple_light"
            app:strokeWidth="2dp"
            style="@style/Widget.Material3.Button.OutlinedButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleMode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="YOLO"
            android:textSize="8sp"
            android:fontFamily="@font/press_start_2p"
            android:backgroundTint="@color/purple_light"
            android:textColor="@color/white"
            app:strokeColor="@color/purple_glow"
            app:strokeWidth="2dp"
            style="@style/Widget.Material3.Button" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
